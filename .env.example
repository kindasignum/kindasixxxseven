VK_TOKEN=токен_сообщества
VK_GROUP_ID=123456789
DB_PATH=trainings.db
# На хостинге вместо DB_PATH задайте DATA_DIR=/app/data (постоянный диск): база будет лежать в /app/data/trainings.db
DATA_DIR=

# ID реакций: python bot.py --assets
REACTION_THUMBS_UP=
REACTION_EYE=
REACTION_CHECK=
REACTION_QUESTION=

# ── Google Таблица (см. инструкцию) ──
# Локально: путь к файлу-ключу. НА ХОСТИНГЕ файл не нужен — используйте GOOGLE_CREDENTIALS_JSON
GOOGLE_CREDENTIALS_FILE=google_credentials.json
# На хостинге: содержимое credentials_b64.txt (см. python encode_credentials.py google_credentials.json)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
SHEET_TRAININGS=Тренировки
SHEET_PARTICIPATIONS=Участия

# ── Настройка бота ──
# Запасной список администраторов сообщества (VK ID через запятую), если VK не отдаёт список руководителей
BOT_ADMIN_IDS=
# Новые беседы: 1 — сразу включены, 0 — выключены до команды «N вкл»
DEFAULT_CHAT_ENABLED=1

# ── Лист «Участники» (сопоставление ВК-страниц и персонажей) ──
SHEET_MEMBERS=Участники
COL_VK_ID=ID вк
COL_CW_ID=ID вар
COL_CW_NAME=Имя на варе
# Если лист «Участники» лежит в ДРУГОЙ таблице — ID той таблицы (иначе оставьте пустым)
GOOGLE_MEMBERS_SHEET_ID=

# ── Правки сообщений ──
# Раз в сколько секунд перепроверять непонятные «#…»-сообщения на правки (запасной механизм, если ВК
# не присылает событие message_edit). 0 — выключить.
EDIT_POLL_SEC=20
# 1 — писать в лог тип каждого события Long Poll (для диагностики)
LOG_EVENTS=0
